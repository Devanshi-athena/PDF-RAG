# Hugging Face token: create one at https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token

# ---- Models (every model and provider is swappable here; no code changes needed) ---------------------------
# Defaults are the lowest-cost options on Hugging Face Inference Providers, so a demo fits inside the account's
# monthly included credits. Each model is pinned to a provider: with an empty provider HF may route to a pricier one.

# Chat model for all generated answers. Llama-3.1-8B on novita: ~$0.02 / $0.05 per 1M input/output tokens,
# 16k-token context (prompts here stay under ~10k). Low-cost alternative: Qwen/Qwen3-4B-Instruct-2507 on nscale.
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_PROVIDER=novita

# Optional second model for analysis, comparison, multi-part, list and vague questions.
# Empty = use HF_CHAT_MODEL (cheapest). A larger model (e.g. meta-llama/Llama-3.3-70B-Instruct) is billed ~8x more.
HF_ANALYSIS_MODEL=
HF_ANALYSIS_PROVIDER=

# Embeddings: served by Hugging Face's own hf-inference provider.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_PROVIDER=hf-inference
# hf: embeddings via the API | hybrid: documents via the API, questions on this machine (faster answers)
# local: everything on this machine (uses no API credits at all; slower indexing on CPU)
# hybrid/local need the sentence-transformers package.
EMBEDDING_BACKEND=hf
# Optional local cross-encoder reranker (needs sentence-transformers), e.g. cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_MODEL=

# Speech-to-text: Whisper on hf-inference.
HF_ASR_MODEL=openai/whisper-large-v3-turbo
HF_ASR_URL=https://router.huggingface.co/hf-inference
CHROMA_DIR=data/chroma
THREADS_FILE=data/threads.json
DOCUMENTS_DIR=data/documents
STRUCTURE_DIR=data/structure
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_BATCH_SIZE=32
EMBEDDING_WORKERS=4
TOP_K=6
# Abstain threshold for cosine similarity (tuned for all-MiniLM-L6-v2; retune if you change EMBEDDING_MODEL)
RETRIEVAL_MIN_SIMILARITY=0.30
QA_CONTEXT_CHARS=14000
ANALYSIS_CONTEXT_CHARS=22000
EXPLAIN_CONTEXT_CHARS=28000
RANGE_UNIT_CONTEXT_CHARS=8000
OVERVIEW_CONTEXT_CHARS=20000
MAX_ANSWER_TOKENS=1000
LLM_WORKERS=8
MAX_UNITS_PER_REQUEST=25
TEMPERATURE=0
MAX_PDF_BYTES=52428800
